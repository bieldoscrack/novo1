# === WALLET (obrigatório para trading) ===
PRIVATE_KEY=                    # Hex, com ou sem 0x. Wallet DEDICADA, nunca a principal!
FUNDER_ADDRESS=                 # Endereço que segura os fundos (se proxy wallet)
SIGNATURE_TYPE=0                # 0=EOA padrão, 1=Magic/email, 2=GnosisSafe

# === POLYMARKET ===
CLOB_API_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com
DATA_API_URL=https://data-api.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/
CHAIN_ID=137

# === BINANCE (feed público, sem auth) ===
BINANCE_WS_URL=wss://stream.binance.com:9443/stream?streams=btcusdt@trade/ethusdt@trade/solusdt@trade

# === TELEGRAM (opcional mas recomendado) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === ESTRATÉGIA ===
INITIAL_CAPITAL=500
PAIR_COST_THRESHOLD=0.98
COPY_RATIO=0.3
MAX_EXPOSURE_PCT=0.50
MIN_RESERVE_PCT=0.20
STOP_LOSS_DAILY_PCT=0.05
STOP_LOSS_PAUSE_HOURS=6

# === COPY TRADE WALLETS (separado por vírgula) ===
COPY_WALLETS=0xabc123,0xdef456

# === INFRAESTRUTURA ===
DASHBOARD_PORT=8080
SIMULATION_MODE=true
LOG_LEVEL=INFO
